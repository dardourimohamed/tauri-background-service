# Build artifacts
target/

# Plugin binary lock is tracked at tauri-plugin-background-service/Cargo.lock
# (binary crate). Do NOT ignore Cargo.lock globally — that hides binary locks
# and broke the plugin's lock from the root .gitignore in past revisions.
# Keep the test-app lock tracked at test-app/src-tauri/Cargo.lock.

# Node
node_modules/
dist/
dist-js/

# IDE
.idea/
.vscode/
*.swp
*.swp

# OS
.DS_Store
Thumbs.db

# Python (test-app/run-tests.py artifacts)
__pycache__/
*.pyc

# Logs
*.log
logs/

# Agent/orchestration artifacts
.agents/
.ralph/
.worktrees/
.eval-sandbox/

# Local secrets — never commit. Rotate immediately if you ever suspect a leak.
.env
.env.*
!.env.example
